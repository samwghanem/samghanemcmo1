---
import CTAButton from './CTAButton.astro';

interface Props {
  headline: string;
  body: string;
  ctaLabel: string;
  ctaHref: string;
}

const { headline, body, ctaLabel, ctaHref } = Astro.props;
---

<div class="gate">
  <div class="stamp" aria-hidden="true">
    <span class="stamp-line-1">BY APPLICATION</span>
    <span class="stamp-line-2">SELECTIVE FIT</span>
  </div>
  <div class="gate-copy">
    <h2>{headline}</h2>
    <p>{body}</p>
    <CTAButton href={ctaHref} label={ctaLabel} variant="primary" />
  </div>
</div>

<style>
  .gate {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    background: var(--paper-raised);
    border: 1.5px solid var(--line);
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .stamp {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 9rem;
    height: 9rem;
    flex-shrink: 0;
    border: 1.5px solid var(--stamp-red);
    border-radius: 50%;
    transform: rotate(-6deg);
    color: var(--stamp-red);
    text-align: center;
    line-height: 1.3;
    opacity: 0.92;
  }

  .stamp-line-1 {
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .stamp-line-2 {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    margin-top: 0.35em;
  }

  .gate-copy h2 {
    margin-bottom: 0.4em;
  }

  @media (max-width: 640px) {
    .gate {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
    }
  }
</style>
