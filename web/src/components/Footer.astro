---
const footerLinks = [
  { label: 'About', path: '/about' },
  { label: 'How It Works', path: '/how-it-works' },
  { label: 'Results', path: '/results' },
  { label: 'Apply', path: '/apply' },
  { label: 'Privacy Policy', path: '/privacy-policy' },
];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <p class="wordmark">Sam Ghanem, CMO</p>
      <p class="tagline">Fractional CMO for established, revenue-scaled companies.</p>
    </div>
    <nav class="footer-nav">
      {footerLinks.map((item) => (
        <a href={item.path}>{item.label}</a>
      ))}
    </nav>
  </div>
  <p class="copyright">&copy; {year} Sam Ghanem. All rights reserved.</p>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--paper);
    padding: clamp(2.5rem, 5vw, 3.5rem) clamp(1.25rem, 5vw, 3rem) 1.5rem;
  }

  .footer-inner {
    max-width: 50rem;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line-on-dark);
  }

  .footer-brand .wordmark {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 400;
    margin: 0 0 0.4em;
  }

  .tagline {
    font-family: var(--font-label);
    font-size: 0.82rem;
    color: rgba(237, 234, 226, 0.6);
    margin: 0;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem 1.6rem;
    font-family: var(--font-label);
    font-size: 0.82rem;
  }

  .footer-nav a {
    position: relative;
    text-decoration: none;
    color: rgba(237, 234, 226, 0.72);
    padding-bottom: 2px;
    transition: color 0.15s ease;
  }

  .footer-nav a::after {
    content: '';
    position: absolute;
    left: 0; bottom: 0;
    width: 100%; height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .footer-nav a:hover {
    color: var(--gold);
  }

  .footer-nav a:hover::after {
    transform: scaleX(1);
  }

  .copyright {
    max-width: 50rem;
    margin: 1.5rem auto 0;
    font-family: var(--font-label);
    font-size: 0.72rem;
    color: rgba(237, 234, 226, 0.42);
  }
</style>
