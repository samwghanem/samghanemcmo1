---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';
import ProofBar from '../components/ProofBar.astro';
import QualificationGate from '../components/QualificationGate.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Sam Ghanem, Fractional CMO',
  url: 'https://samghanemcmo.com',
  founder: {
    '@type': 'Person',
    name: 'Sam Ghanem',
    jobTitle: 'Fractional CMO',
  },
  areaServed: 'US',
  description:
    'Fractional CMO services for established, revenue-scaled companies.',
};

const stats = [
  { value: '25+', label: 'Yrs Brand & Marketing Strategy', count: 25, suffix: '+' },
  { value: '21', label: 'Person Agency Built (SG INK)', count: 21 },
  { value: '6+', label: 'Enterprise Clients Served', count: 6, suffix: '+' },
  { value: "'02", label: 'Career Began' },
];

const faqs = [
  {
    question: "What exactly does a Fractional CMO do that an agency doesn't?",
    answer:
      "An agency executes tasks you hand it. A Fractional CMO owns the outcome: diagnosing why marketing isn't converting, rebuilding the message underneath it, and running the whole system with the same accountability a full-time executive would carry - not the accountability of a vendor.",
  },
  {
    question: 'Who is this actually for?',
    answer:
      "Companies who've moved well past the startup stage - real revenue, an actual sales team, a P&L to defend - but haven't built out a full in-house marketing leadership team yet. If you're pre-revenue or still finding product-market fit, this isn't the right fit. If you're a public enterprise with a marketing department twelve layers deep, you probably don't need this either.",
  },
  {
    question: 'Do you work with any company that can afford it?',
    answer:
      "No. Revenue gets you in the room, but it's not the qualifier. If you can't say why the business exists beyond the number on the P&L - and actually believe it - we're probably not a fit. Growth for its own sake doesn't hold up long enough to be worth building on.",
  },
  {
    question: 'How fast will I see results?',
    answer:
      "The diagnostic phase alone usually surfaces the gap within the first few weeks - most companies are surprised how fast it's visible once someone's actually looking for it. Full deployment and measurable pipeline impact follow the four-phase process outlined on the How It Works page.",
  },
  {
    question: "What's the investment?",
    answer:
      "Engagements start at $7,500 per month. Exact scope depends on what phase you're in and how much of the system needs rebuilding, but that's the floor. Better to know that now than after an application.",
  },
];
---

<BaseLayout
  title="Fractional CMO for Established Companies | Sam Ghanem"
  description="Sam Ghanem is a Fractional CMO for established, revenue-scaled companies that have outgrown guesswork. Enterprise-grade marketing leadership, without the enterprise headcount."
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="section-inner">
      <p class="eyebrow">Fractional CMO for Serious Companies</p>
      <h1 class="dz-split">
        <span class="dz-split-line"><span>Your Marketing Doesn't Need Another Hire.</span></span>
        <span class="dz-split-line"><span>It Needs An Executive.</span></span>
      </h1>
      <p class="subhead">
        You built a real company - past the startup phase, with an actual sales team
        and a P&amp;L to defend. Your marketing hasn't caught up. It still runs like a
        garage operation, and that gap gets more expensive every quarter it stays open.
      </p>
      <CTAButton href="/apply" label="See If You Qualify" />
    </div>
  </section>

  <section class="proof">
    <div class="section-inner">
      <ProofBar stats={stats} />
    </div>
  </section>

  <section>
    <div class="section-inner">
      <p class="eyebrow">The Diagnosis</p>
      <hr class="dz-draw" />
      <h2 class="dz-reveal">You Don't Have a Marketing Problem. You Have a Messaging Problem.</h2>
      <p class="dz-reveal" style="--dz-delay: 0.1s">
        Most companies at your revenue level didn't stall because they stopped
        advertising. They stalled because the brand went incongruent - what you say,
        what you sell, and what your team actually delivers started pulling in three
        different directions. No amount of ad spend fixes that. A Fractional CMO does.
      </p>
      <CTAButton href="/how-it-works" label="See the System" variant="ghost-light" />
    </div>
  </section>

  <section class="section-dark">
    <div class="section-inner">
      <p class="eyebrow">The Mechanism</p>
      <hr class="dz-draw" />
      <h2 class="dz-reveal">The Congruent Brands Convert System</h2>
      <p class="dz-reveal" style="--dz-delay: 0.1s">
        This isn't a grab bag of tactics. It's a repeatable system, built over two
        decades and stress-tested by enterprise clients who don't tolerate guesswork.
      </p>
      <ol class="phase-list">
        <li class="dz-reveal" style="--dz-delay: 0.15s"><strong>Diagnose the Gap</strong> - find exactly where brand, message, and go-to-market stop matching what's actually converting.</li>
        <li class="dz-reveal" style="--dz-delay: 0.22s"><strong>Rebuild the Why Pathway</strong> - rebuild the core message so every channel says the same true thing, every time.</li>
        <li class="dz-reveal" style="--dz-delay: 0.29s"><strong>Install Magnetic Marketing</strong> - deploy the systems that pull the right buyers toward you, not just more traffic your way.</li>
        <li class="dz-reveal" style="--dz-delay: 0.36s"><strong>Run It Like an Executive</strong> - ongoing fractional leadership, not a deliverable that sits in a drawer.</li>
      </ol>
      <CTAButton href="/results" label="See the Proof" variant="ghost-dark" />
    </div>
  </section>

  <section>
    <div class="section-inner">
      <p class="eyebrow">Sound Familiar?</p>
      <hr class="dz-draw" />
      <h2 class="dz-reveal">You Might Recognize Yourself Here</h2>
      <ul class="symptom-list">
        <li class="dz-reveal" style="--dz-delay: 0.1s">Your message sounds smart. Your leads still come in cold.</li>
        <li class="dz-reveal" style="--dz-delay: 0.16s">Your team is executing hard. Your KPIs don't reflect the effort.</li>
        <li class="dz-reveal" style="--dz-delay: 0.22s">Your website, your brand, and your sales team are speaking three different languages.</li>
        <li class="dz-reveal" style="--dz-delay: 0.28s">You're doing it all yourself, and what you actually need is someone who's done this before.</li>
        <li class="dz-reveal" style="--dz-delay: 0.34s">The systems you have don't match the growth you're chasing.</li>
      </ul>
    </div>
  </section>

  <section>
    <div class="section-inner">
      <QualificationGate
        headline="This Is Built For A Specific Kind Of Company"
        body="This isn't for early-stage startups, and it isn't for public enterprises with a marketing department twelve layers deep. It's for companies with real scale, a sales team, and a P&L that proves it - who need executive-level marketing leadership without adding a six-figure headcount line. It's also not for companies chasing growth for its own sake. If you can't say why the business exists beyond the revenue, we're probably not a fit. If that's you, keep going."
        ctaLabel="Apply to Work Together"
        ctaHref="/apply"
      />
    </div>
  </section>

  <section>
    <div class="section-inner">
      <p class="eyebrow">Frequently Asked</p>
      <hr class="dz-draw" />
      <h2 class="dz-reveal">Before You Apply</h2>
      <FAQAccordion items={faqs} />
    </div>
  </section>

  <section class="section-dark final-cta">
    <div class="section-inner">
      <h2>See If You Qualify</h2>
      <p>
        A quick application, not a sales call. If it's a fit, we'll talk. If it's not,
        I'll tell you that too.
      </p>
      <CTAButton
        href="/apply"
        label="Start My Application"
        pulse={true}
        pulseColor="rgba(237, 234, 226, 0.32)"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: clamp(3.5rem, 10vw, 7rem);
  }

  .subhead {
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: 40rem;
    margin-bottom: 1.6em;
  }

  .proof {
    padding-top: 0;
  }

  .phase-list {
    list-style: none;
    counter-reset: phase;
    padding: 0;
    margin: 1.8em 0 2em;
    display: grid;
    gap: 1.1rem;
  }

  .phase-list li {
    counter-increment: phase;
    position: relative;
    padding-left: 2.6rem;
    color: rgba(237, 234, 226, 0.85);
  }

  .phase-list li::before {
    content: counter(phase);
    position: absolute;
    left: 0;
    top: 0.05em;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--gold);
    border: 1px solid var(--gold);
    border-radius: 50%;
    width: 1.7rem;
    height: 1.7rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
  }

  .phase-list strong {
    color: var(--paper-raised);
  }

  .final-cta p {
    max-width: 34rem;
    color: rgba(237, 234, 226, 0.8);
  }

  .symptom-list {
    list-style: none;
    padding: 0;
    margin: 1.6em 0 0;
    display: grid;
    gap: 0.9rem;
    max-width: 38rem;
  }

  .symptom-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink-soft);
    font-size: 1.05rem;
  }

  .symptom-list li::before {
    content: '-';
    position: absolute;
    left: 0;
    color: var(--gold);
    font-weight: 700;
  }
</style>
