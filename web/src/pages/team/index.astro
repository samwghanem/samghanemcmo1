---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isTeamAuthenticated, getTeamSessionEmail } from '../../lib/team-auth';
import { getAllJobs, failStaleJobs, type TeamJob } from '../../lib/team-db';
import { TEAM_ROSTER, DEPARTMENTS, photoUrl } from '../../lib/team-roster';

if (!(await isTeamAuthenticated(Astro.cookies))) {
  return Astro.redirect('/team/login');
}

const sessionEmail = await getTeamSessionEmail(Astro.cookies);
const isGuest = (sessionEmail ?? '').startsWith('guest:');

// A job that was cut off (for example a server timeout) is marked failed
// instead of sitting in "Being made" forever.
await failStaleJobs();
const jobs = await getAllJobs();

const oneWeekAgo = new Date();
oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);

function countsFor(roleKey: string) {
  const roleJobs = jobs.filter((j) => j.role_key === roleKey);
  const open = roleJobs.filter((j) => j.status === 'running').length;
  // "Waiting on you" is anything that failed and needs a retry.
  const waiting = roleJobs.filter((j) => j.status === 'error').length;
  const thisWeek = roleJobs.filter((j) => new Date(j.created_at) >= oneWeekAgo).length;
  return { open, waiting, thisWeek };
}

// Level is grounded in real history, not a decorative number: one level per
// 5 finished jobs for that role, capped at the role's own ceiling.
// Everyone starts at Level 1.
const JOBS_PER_LEVEL = 5;
function levelFor(roleKey: string, maxLevel: number) {
  const doneCount = jobs.filter((j) => j.role_key === roleKey && j.status === 'done').length;
  const earned = 1 + Math.floor(doneCount / JOBS_PER_LEVEL);
  return Math.min(earned, maxLevel);
}

const runningJobs = jobs.filter((j) => j.status === 'running');
const doneJobs = jobs.filter((j) => j.status === 'done');
const errorJobs = jobs.filter((j) => j.status === 'error');

const memberFor = (key: string) => TEAM_ROSTER.find((m) => m.key === key);
const fmt = (d: string | Date) =>
  new Date(d).toLocaleString('en-US', {
    timeZone: 'America/New_York',
    month: 'short',
    day: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
  });
---

<BaseLayout
  title="The Floor | Sam Ghanem, CMO"
  description="Private AI creative team dashboard."
  canonicalPath="/team"
  noindex={true}
>
  <section class="team-section" data-running={runningJobs.length}>
    <div class="team-header">
      <div>
        <p class="eyebrow">Sam Ghanem, CMO &middot; {sessionEmail}</p>
        <h1>The Floor</h1>
      </div>
      <div class="tabs">
        <button class="tab-btn active" data-tab="floor">The Floor</button>
        <button class="tab-btn" data-tab="jobs">
          Jobs {runningJobs.length > 0 && <span class="badge badge-blue">{runningJobs.length}</span>}
        </button>
        <button class="tab-btn" data-tab="needs-you">
          Needs You {errorJobs.length > 0 && <span class="badge">{errorJobs.length}</span>}
        </button>
        <button class="tab-btn" data-tab="submit">Submit a Job</button>
        {!isGuest && <button class="tab-btn share-btn" id="share-btn" type="button">Create Guest Link</button>}
      </div>
    </div>

    {errorJobs.length > 0 && (
      <div class="alert-strip">
        {errorJobs.length} job{errorJobs.length === 1 ? '' : 's'} failed to run - open Needs You to retry.
      </div>
    )}

    <!-- THE FLOOR TAB -->
    <div class="tab-panel" id="panel-floor">
      {DEPARTMENTS.map((dept) => (
        <div class="dept-block">
          <p class="dept-label">{dept.toUpperCase()}</p>
          <div class="roster-grid">
            {TEAM_ROSTER.filter((m) => m.department === dept).map((member) => {
              const c = countsFor(member.key);
              const level = levelFor(member.key, member.maxLevel);
              return (
                <div class={`member-card ${c.waiting > 0 ? 'needs-attention' : ''} ${c.open > 0 ? 'is-working' : ''}`}>
                  <div class="member-top">
                    <img class="member-photo" src={photoUrl(member.name)} alt={member.name} width="56" height="56" loading="lazy" />
                    <div class="member-id">
                      <div class="name-row">
                        <span class="status-dot"></span>
                        <strong>{member.name}</strong>
                      </div>
                      <p class="member-role">{member.role}</p>
                      <span class="level-chip">Level {level} of {member.maxLevel}</span>
                    </div>
                  </div>
                  <div class="member-stats">
                    <div><strong>{c.open}</strong><span>Open</span></div>
                    <div><strong>{c.waiting}</strong><span>Waiting on you</span></div>
                    <div><strong>{c.thisWeek}</strong><span>This week</span></div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <!-- JOBS TAB: what is being made, and what is done -->
    <div class="tab-panel hidden" id="panel-jobs">
      <p class="panel-intro">Every job, from the moment you send it. <span class="checked-chip" id="checked-chip">Checked just now</span></p>
      <div class="board">
        <div class="board-col">
          <div class="board-head"><span class="col-dot dot-blue"></span><strong>Being made</strong><span class="col-count">{runningJobs.length}</span></div>
          {runningJobs.length === 0 && <p class="empty-note">Nothing in progress.</p>}
          {runningJobs.map((job) => {
            const m = memberFor(job.role_key);
            return (
              <div class="job-card running-card">
                <span class="status-chip chip-blue"><span class="pulse"></span>working</span>
                <p class="job-who">{m?.name} <span>&middot; {m?.role}</span></p>
                <p class="job-when">Started {fmt(job.created_at)}</p>
                <p class="job-request">{job.request}</p>
              </div>
            );
          })}
        </div>

        <div class="board-col">
          <div class="board-head"><span class="col-dot dot-green"></span><strong>Done</strong><span class="col-count">{doneJobs.length}</span></div>
          {doneJobs.length === 0 && <p class="empty-note">Finished jobs will show up here.</p>}
          {doneJobs.map((job) => {
            const m = memberFor(job.role_key);
            return (
              <div class="job-card done-card" data-job-id={job.id}>
                <span class="status-chip chip-green">done</span>
                <p class="job-who">{m?.name} <span>&middot; {m?.role}</span></p>
                <p class="job-when">Finished {job.completed_at ? fmt(job.completed_at) : ''}</p>
                <p class="job-request">{job.request}</p>
                <details class="job-details">
                  <summary>Open</summary>
                  <div class="job-result">{job.result}</div>
                  <div class="job-actions">
                    <button class="copy-btn" type="button">Copy</button>
                    <button class="delete-job-btn" type="button" data-id={job.id}>Delete</button>
                  </div>
                </details>
              </div>
            );
          })}
        </div>
      </div>
    </div>

    <!-- NEEDS YOU TAB: only things that failed and need a retry -->
    <div class="tab-panel hidden" id="panel-needs-you">
      <p class="panel-intro">{errorJobs.length === 0 ? 'Nothing needs you right now.' : `${errorJobs.length} job${errorJobs.length === 1 ? '' : 's'} didn't finish.`}</p>
      <div class="job-list">
        {errorJobs.map((job) => {
          const m = memberFor(job.role_key);
          return (
            <div class="job-card error-card" data-job-id={job.id}>
              <span class="status-chip chip-red">failed</span>
              <p class="job-who">{m?.name} <span>&middot; {m?.role}</span></p>
              <p class="job-request"><strong>Request:</strong> {job.request}</p>
              <div class="job-result error-text">{job.error_message}</div>
              <div class="job-actions">
                <button class="retry-btn" type="button" data-id={job.id}>Retry</button>
                <button class="delete-job-btn" type="button" data-id={job.id}>Dismiss</button>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- SUBMIT TAB -->
    <div class="tab-panel hidden" id="panel-submit">
      <p class="panel-intro">Pick who should handle this, describe what you need, and send it to work. It will appear under Jobs right away.</p>
      <form id="submit-form">
        <label>
          Who should take this?
          <select name="roleKey" id="role-select" required>
            <option value="">Select a team member</option>
            {DEPARTMENTS.map((dept) => (
              <optgroup label={dept}>
                {TEAM_ROSTER.filter((m) => m.department === dept).map((m) => (
                  <option value={m.key}>{m.name} - {m.role}</option>
                ))}
              </optgroup>
            ))}
          </select>
        </label>
        <label>
          What do you need?
          <textarea name="request" id="request-input" rows="5" placeholder="e.g. I need five headline options for a LinkedIn post about the gap between messaging and delivery." required></textarea>
        </label>
        <button type="submit" id="submit-btn">Send to Work &rarr;</button>
        <p id="submit-status" class="submit-status"></p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  // ---- tabs (remembered in the URL so a refresh keeps you where you were) ----
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn[data-tab]');
  const panels: Record<string, HTMLElement> = {
    floor: document.getElementById('panel-floor')!,
    jobs: document.getElementById('panel-jobs')!,
    'needs-you': document.getElementById('panel-needs-you')!,
    submit: document.getElementById('panel-submit')!,
  };

  function showTab(tab: string) {
    if (!panels[tab]) tab = 'floor';
    tabButtons.forEach((b) => b.classList.toggle('active', b.dataset.tab === tab));
    Object.entries(panels).forEach(([key, el]) => el.classList.toggle('hidden', key !== tab));
    history.replaceState(null, '', tab === 'floor' ? location.pathname : `#${tab}`);
  }
  tabButtons.forEach((btn) => btn.addEventListener('click', () => showTab(btn.dataset.tab!)));
  showTab(location.hash.replace('#', '') || 'floor');

  // ---- submit a job: it starts in the background, then jump to the Jobs board ----
  const form = document.getElementById('submit-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const statusMsg = document.getElementById('submit-status') as HTMLParagraphElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';
    statusMsg.textContent = '';
    statusMsg.className = 'submit-status';

    const formData = new FormData(form);
    try {
      const res = await fetch('/api/team/jobs', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ roleKey: formData.get('roleKey'), request: formData.get('request') }),
      });
      if (res.ok) {
        form.reset();
        location.hash = '#jobs';
        location.reload();
      } else {
        const data = await res.json().catch(() => ({}));
        statusMsg.textContent = data.error || 'Something went wrong.';
        statusMsg.className = 'submit-status error';
      }
    } catch {
      statusMsg.textContent = 'Network error. Please try again.';
      statusMsg.className = 'submit-status error';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send to Work →';
    }
  });

  // ---- live updates: while anything is being made, check every 4 seconds ----
  const section = document.querySelector('.team-section') as HTMLElement;
  const startingRunning = Number(section.dataset.running || 0);
  const checkedChip = document.getElementById('checked-chip');

  function stamp() {
    if (checkedChip) {
      const t = new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
      checkedChip.textContent = `Checked ${t}${startingRunning > 0 ? ' · refreshes automatically' : ''}`;
    }
  }
  stamp();

  if (startingRunning > 0) {
    const poll = setInterval(async () => {
      try {
        const res = await fetch('/api/team/status', { cache: 'no-store' });
        if (!res.ok) return;
        const data = await res.json();
        stamp();
        if (data.running < startingRunning) {
          clearInterval(poll);
          location.reload(); // something finished - show it
        }
      } catch {
        /* try again on the next tick */
      }
    }, 4000);
  }

  // ---- guest link ----
  const shareBtn = document.getElementById('share-btn') as HTMLButtonElement | null;
  shareBtn?.addEventListener('click', async () => {
    const label = prompt('Who is this link for? (e.g. "Ken")') || 'Guest';
    shareBtn.disabled = true;
    shareBtn.textContent = 'Creating...';
    try {
      const res = await fetch('/api/team/share-link', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ label }),
      });
      const data = await res.json();
      if (res.ok) {
        prompt('Share this link (valid for 48 hours). Copy it below:', data.url);
      } else {
        alert(data.error || 'Failed to create link.');
      }
    } catch {
      alert('Network error. Please try again.');
    } finally {
      shareBtn.disabled = false;
      shareBtn.textContent = 'Create Guest Link';
    }
  });

  // ---- retry / delete / copy ----
  document.querySelectorAll<HTMLButtonElement>('.retry-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      btn.textContent = 'Retrying...';
      const res = await fetch(`/api/team/jobs/${btn.dataset.id}`, { method: 'POST' });
      if (res.ok) {
        location.hash = '#jobs';
        location.reload();
      } else {
        const data = await res.json().catch(() => ({}));
        alert(data.error || 'Could not retry. Please try again.');
        btn.disabled = false;
        btn.textContent = 'Retry';
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.delete-job-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!confirm('Delete this job? This cannot be undone.')) return;
      const res = await fetch(`/api/team/jobs/${btn.dataset.id}`, { method: 'DELETE' });
      if (res.ok) location.reload();
      else alert('Could not delete. Please try again.');
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.closest('.job-details')?.querySelector('.job-result')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'Copied';
        setTimeout(() => (btn.textContent = 'Copy'), 1500);
      } catch {
        alert('Could not copy automatically. Select the text and copy it.');
      }
    });
  });
</script>

<style>
  .team-section {
    padding: 2rem clamp(1rem, 4vw, 2.5rem);
    max-width: 90rem;
    margin: 0 auto;
  }
  .team-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .eyebrow {
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
    margin: 0;
  }
  h1 {
    font-family: var(--font-display);
    font-size: 1.9rem;
    color: var(--ink);
    margin: 0.1em 0 0;
  }
  .tabs {
    display: flex;
    gap: 0.5rem;
  }
  .tab-btn {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.6em 1.1em;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 3px;
    cursor: pointer;
    color: var(--ink-soft);
  }
  .tab-btn.active {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .share-btn {
    border-style: dashed;
  }
  .badge {
    background: var(--gold);
    color: var(--paper);
    border-radius: 999px;
    padding: 0.1em 0.5em;
    font-size: 0.75rem;
    margin-left: 0.3em;
  }
  .alert-strip {
    background: rgba(184, 75, 34, 0.1);
    border: 1px solid var(--stamp-red);
    color: var(--stamp-red);
    padding: 0.8em 1.2em;
    border-radius: 3px;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }
  .hidden { display: none; }
  .dept-block { margin-bottom: 2rem; }
  .dept-label {
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin-bottom: 0.6em;
  }
  .roster-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0.8rem;
  }
  .member-card {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.9em 1em;
  }
  .member-card.needs-attention {
    border-color: var(--gold);
  }
  .name-row {
    display: flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-label);
    font-size: 1rem;
  }
  .status-dot {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: #3a8a5c;
    display: inline-block;
  }
  .level-chip {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-soft);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.15em 0.6em;
    display: inline-block;
    margin-top: 0.4em;
  }
  .member-top {
    display: flex;
    align-items: center;
    gap: 0.8em;
    margin-bottom: 0.8em;
  }
  .member-photo {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line);
    flex-shrink: 0;
    background: var(--paper);
  }
  .member-id {
    min-width: 0;
  }
  .member-role {
    font-size: 0.78rem;
    color: var(--ink-soft);
    margin: 0.1em 0 0;
  }
  .member-stats {
    display: flex;
    gap: 0.9rem;
  }
  .member-stats div {
    display: flex;
    flex-direction: column;
    font-size: 0.72rem;
    color: var(--ink-soft);
  }
  .member-stats strong {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    color: var(--ink);
  }
  .panel-intro {
    color: var(--ink-soft);
    margin-bottom: 1.2rem;
  }
  .job-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .job-card {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 1.1em 1.3em;
  }
  .job-card.error-card {
    border-color: var(--stamp-red);
  }
  .job-card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.6em;
  }
  .job-meta {
    font-size: 0.78rem;
    color: var(--ink-soft);
  }
  .job-request {
    font-size: 0.9rem;
    margin-bottom: 0.8em;
  }
  .job-result {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 1em;
    white-space: pre-wrap;
    font-size: 0.88rem;
    line-height: 1.5;
    max-height: 24rem;
    overflow-y: auto;
    margin-bottom: 1em;
  }
  .job-result.error-text {
    color: var(--stamp-red);
  }
  .job-actions {
    display: flex;
    gap: 0.6rem;
  }
  .empty-note {
    color: var(--ink-soft);
    font-style: italic;
  }
  #submit-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    max-width: 36rem;
  }
  #submit-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    font-family: var(--font-label);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink);
  }
  #submit-form select,
  #submit-form textarea {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 400;
    padding: 0.7em 0.9em;
    border: 1px solid var(--line);
    background: var(--paper-raised);
    border-radius: 2px;
    color: var(--ink);
  }
  #submit-btn {
    font-family: var(--font-label);
    font-weight: 600;
    background: var(--ink);
    color: var(--paper);
    border: none;
    padding: 0.85em 1.5em;
    border-radius: 2px;
    cursor: pointer;
    width: fit-content;
  }
  #submit-btn:hover:not(:disabled) {
    background: var(--gold-deep);
  }
  #submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .submit-status.success { color: var(--gold-deep); font-weight: 600; }
  .submit-status.error { color: var(--stamp-red); font-weight: 600; }

  .badge-blue { background: #2f6fb3; }
  .member-card.is-working { border-color: #2f6fb3; }
  .checked-chip {
    display: inline-block;
    font-family: var(--font-label);
    font-size: 0.75rem;
    color: var(--ink-soft);
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.25em 0.8em;
    margin-left: 0.5em;
  }
  .board {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1.2rem;
    align-items: start;
  }
  .board-col {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .board-head {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-label);
    font-size: 0.95rem;
  }
  .col-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
  .col-dot { width: 0.7em; height: 0.7em; border-radius: 2px; display: inline-block; }
  .dot-blue { background: #2f6fb3; }
  .dot-green { background: #3a8a5c; }
  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 999px;
    padding: 0.2em 0.8em;
    width: fit-content;
  }
  .chip-blue { background: rgba(47, 111, 179, 0.12); color: #2f6fb3; }
  .chip-green { background: rgba(58, 138, 92, 0.14); color: #2d7048; }
  .chip-red { background: rgba(184, 75, 34, 0.12); color: var(--stamp-red); }
  .pulse {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: #2f6fb3;
    animation: pulse 1.2s ease-in-out infinite;
